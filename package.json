{
  "name": "wa-mini-league",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "wrangler pages dev public --d1=DB --r2=REPLAYS",
    "deploy": "wrangler pages deploy public",
    "db:migrate:local": "wrangler d1 execute wa-mini-league-db --local --file=migrations/0001_init.sql",
    "db:migrate:remote": "wrangler d1 execute wa-mini-league-db --remote --file=migrations/0001_init.sql"
  },
  "devDependencies": {
    "wrangler": "^3.78.0"
  }
}
